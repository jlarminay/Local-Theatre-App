{
  "name": "local-theatre",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "patch-package",
    "start": "vite",
    "build": "npm run typecheck && vite build && vite build --config vite.runner.config.ts",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.plugins.json && tsc -p tsconfig.node.json",
    "test": "node --test \"plugins/**/*.test.ts\" \"src/host/**/*.test.ts\" \"src/lib/**/*.test.ts\"",
    "plugin": "node plugins/sdk/run.ts",
    "plugin:new": "node plugins/sdk/new.ts",
    "icons": "node scripts/make-icon.mjs && capacitor-assets generate --android",
    "key-qr": "node scripts/key-qr.mjs",
    "sync": "npm run build && cap sync android",
    "android": "npm run sync && cap run android",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "8.2.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/background-runner": "^3.0.0",
    "@capacitor/core": "^8.5.3",
    "@capacitor/preferences": "8.0.1",
    "dayjs": "^1.11.23",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "marked": "^18.1.1",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.10",
    "prettier-plugin-vue": "^1.1.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  },
  "allowScripts": {
    "sharp@0.32.6": true
  }
}
