{
  "plugins": ["prettier-plugin-vue", "@ianvs/prettier-plugin-sort-imports"],
  "importOrder": ["<BUILTIN_MODULES>", "<THIRD_PARTY_MODULES>", "", "^@/(.*)$", "", "^[./]"],
  "importOrderParserPlugins": ["typescript", "decorators-legacy"],
  "singleQuote": true,
  "trailingComma": "all",
  "semi": true,
  "endOfLine": "auto",
  "tabWidth": 2,
  "printWidth": 100
}
